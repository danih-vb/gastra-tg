        <mxCell id="64" parent="63" style="vsdxID=50;fillColor=#ffffff;gradientColor=none;shape=stencil();strokeColor=#000000;strokeWidth=4;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[[0,0.5,0],[1,0.5,0],[0.5,1,0],[0.5,0,0]];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1">
