<mxfile host="drawio"><diagram name="GASTRA_Business_Model_Canvas" id="canvas"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="GASTRA – Business Model Canvas" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#1C2738;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1200" height="44" as="geometry"/></mxCell><mxCell id="bloco0" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Parcerias principais&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Restaurantes piloto&lt;/li&gt;&lt;li&gt;Provedores de nuvem&lt;/li&gt;&lt;li&gt;Abrasel e associações do setor&lt;/li&gt;&lt;li&gt;Fornecedores de maquininhas (POS)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#EAF2FD;strokeColor=#6C9EEB;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="6" y="76" width="228" height="548" as="geometry"/></mxCell><mxCell id="bloco1" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Atividades principais&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Desenvolver e manter o sistema&lt;/li&gt;&lt;li&gt;Calibrar os modelos com dado real&lt;/li&gt;&lt;li&gt;Implantar em cada restaurante&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#EAF2FD;strokeColor=#6C9EEB;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="246" y="76" width="228" height="268" as="geometry"/></mxCell><mxCell id="bloco2" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Recursos principais&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Equipe .NET, Angular e Python&lt;/li&gt;&lt;li&gt;Dados da operação do restaurante&lt;/li&gt;&lt;li&gt;Infraestrutura em nuvem&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#EAF2FD;strokeColor=#6C9EEB;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="246" y="356" width="228" height="268" as="geometry"/></mxCell><mxCell id="bloco3" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Proposta de valor&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Praças distribuídas com critério (programação linear)&lt;/li&gt;&lt;li&gt;Sugestão de prato na hora certa&lt;/li&gt;&lt;li&gt;Índice de desempenho composto&lt;/li&gt;&lt;li&gt;Relatórios para decidir com dado&lt;/li&gt;&lt;li&gt;Cliente nunca identificado (LGPD)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#FDECEC;strokeColor=#E06666;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="486" y="76" width="228" height="548" as="geometry"/></mxCell><mxCell id="bloco4" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Relacionamento&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Acompanhamento próximo na implantação&lt;/li&gt;&lt;li&gt;Suporte contínuo&lt;/li&gt;&lt;li&gt;Relatórios de resultado&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#FFF8D6;strokeColor=#E0B400;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="726" y="76" width="228" height="268" as="geometry"/></mxCell><mxCell id="bloco5" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Canais&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Venda consultiva ao gestor&lt;/li&gt;&lt;li&gt;Piloto gratuito ou com desconto&lt;/li&gt;&lt;li&gt;Abrasel e eventos do setor&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#FFF8D6;strokeColor=#E0B400;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="726" y="356" width="228" height="268" as="geometry"/></mxCell><mxCell id="bloco6" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Segmentos de clientes&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Restaurantes à la carte de médio porte&lt;/li&gt;&lt;li&gt;Atendimento por garçom, em praças&lt;/li&gt;&lt;li&gt;Decisões hoje no costume e no “feeling”&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#FFF8D6;strokeColor=#E0B400;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="966" y="76" width="228" height="548" as="geometry"/></mxCell><mxCell id="bloco7" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Estrutura de custos&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Equipe técnica&lt;/li&gt;&lt;li&gt;Hospedagem e processamento em nuvem&lt;/li&gt;&lt;li&gt;Suporte à implantação e ao piloto&lt;/li&gt;&lt;li&gt;Conformidade com a LGPD&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#EAF2FD;strokeColor=#6C9EEB;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="6" y="636" width="588" height="218" as="geometry"/></mxCell><mxCell id="bloco8" value="&lt;div style=&quot;font-size:21px;font-weight:bold;color:#1C2738;margin-bottom:8px&quot;&gt;Fontes de receita&lt;/div&gt;&lt;ul style=&quot;margin:0;padding-left:20px;font-size:19px;line-height:1.3;color:#243042&quot;&gt;&lt;li&gt;Assinatura mensal (SaaS) pelo porte do restaurante&lt;/li&gt;&lt;li&gt;Piloto que vira assinatura&lt;/li&gt;&lt;li&gt;Suporte e customização&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=10;fillColor=#FFF8D6;strokeColor=#E0B400;strokeWidth=2;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="606" y="636" width="588" height="218" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>