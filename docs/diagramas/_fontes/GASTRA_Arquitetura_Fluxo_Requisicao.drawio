<mxfile host="drawio"><diagram name="GASTRA_Arquitetura_Fluxo_Requisicao" id="GASTRA_Arquitetura_Fluxo_Requisicao"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-1" value="GASTRA - Caminho de uma requisição no backend (ex.: PATCH /api/cardapio/1/preco)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="44" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-2" value="&lt;b&gt;Cliente HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Angular,&lt;br&gt;Swagger&lt;br&gt;ou testes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="150" height="260" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-3" value="&lt;b&gt;1. Pipeline do ASP.NET Core&lt;/b&gt;&lt;br&gt;idioma (Accept-Language)&lt;br&gt;autenticação JWT + chave de sessão&lt;br&gt;autorização por papel" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-4" value="&lt;b&gt;2. Controller&lt;/b&gt;&lt;br&gt;CardapioController&lt;br&gt;&lt;i&gt;Gastra.Api&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="180" height="130" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-5" value="&lt;b&gt;3. Caso de uso&lt;/b&gt;&lt;br&gt;AtualizarPrecoItemUseCase&lt;br&gt;valida o formato&lt;br&gt;&lt;i&gt;Gastra.Application&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="220" height="130" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-6" value="&lt;b&gt;4. Entidade&lt;/b&gt;&lt;br&gt;ItemDoCardapio.AtualizarPreco()&lt;br&gt;aplica a regra (preço &amp;gt; 0)&lt;br&gt;&lt;i&gt;Gastra.Domain&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="230" height="130" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-7" value="&lt;b&gt;5. Repositório + UnitOfWork&lt;/b&gt;&lt;br&gt;EF Core grava a alteração&lt;br&gt;&lt;i&gt;Gastra.Infrastructure&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1320" y="150" width="230" height="130" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-8" value="&lt;b&gt;MySQL&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1600" y="165" width="110" height="100" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Fluxo_Requisicao-2" target="GASTRA_Arquitetura_Fluxo_Requisicao-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackg