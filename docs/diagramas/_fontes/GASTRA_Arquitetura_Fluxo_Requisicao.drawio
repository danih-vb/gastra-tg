tryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Fluxo_Requisicao-7" target="GASTRA_Arquitetura_Fluxo_Requisicao-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435.0" y="105"/><mxPoint x="105" y="105"/></Array></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-16" value="401 / 403" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.77;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Fluxo_Requisicao-3" target="GASTRA_Arquitetura_Fluxo_Requisicao-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370.0" y="350"/></Array></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-17" value="&lt;b&gt;FiltroExcecao&lt;/b&gt; (Gastra.Api)&lt;br&gt;converte a exceção em resposta HTTP:&lt;br&gt;400 validação · 404 não encontrado · 422 regra de negócio&lt;br&gt;mensagem no idioma pedido (Gastra.Exceptions)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="440" width="520" height="120" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-18" value="lança exceção" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.46153846153846156;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Fluxo_Requisicao-5" target="GASTRA_Arquitetura_Fluxo_Requisicao-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-19" value="400 / 404 / 422" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Fluxo_Requisicao-17" target="GASTRA_Arquitetura_Fluxo_Requisicao-2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="500"/></Array></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Fluxo_Requisicao-20" value='&lt;b&gt;Formato único de erro:&lt;/b&gt; { "erros": [ "..." ] }, tanto no filtro quanto no 401/403 do pipeline.&lt;br&gt;&lt;br&gt;Cada camada só conhece a de dentro: o controller não acessa o banco, e a entidade não sabe que existe HTTP. A regra do preço vale igual para a API, um teste ou uma futura importação.' style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;fillColor=#fffbe6;strokeColor=#b3a100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="430" width="520" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>