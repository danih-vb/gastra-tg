<mxfile host="drawio"><diagram name="GASTRA_Arquitetura_Implantacao" id="GASTRA_Arquitetura_Implantacao"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="GASTRA_Arquitetura_Implantacao-1" value="GASTRA - Diagrama de implantação" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1500" height="44" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-2" value="Dispositivos dos usuários" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="330" height="520" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-3" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;br&gt;SPA Angular&lt;br&gt;&lt;i&gt;garçom e metre: celular&lt;br&gt;gerente: computador&lt;br&gt;cliente: celular (QR code da mesa)&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="270" height="170" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-4" value="Servidor — Docker Compose" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="80" width="1060" height="700" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-5" value="&lt;b&gt;web&lt;/b&gt; (nginx)&lt;br&gt;arquivos estáticos do Angular" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="330" height="90" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-6" value="&lt;b&gt;api&lt;/b&gt; — ASP.NET Core (.NET 10)&lt;br&gt;regras de negócio, autenticação,&lt;br&gt;gravação no banco" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#36393d;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="330" height="120" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-7" value="&lt;b&gt;analitica&lt;/b&gt; — Python + FastAPI&lt;br&gt;recomendação de pratos (mlxtend)&lt;br&gt;alocação de garçons (PuLP)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="340" height="120" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-8" value="&lt;b&gt;mysql&lt;/b&gt; — MySQL 8.4&lt;br&gt;tabelas + views de BI&lt;br&gt;volume persistente" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="530" y="530" width="330" height="150" as="geometry"/></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-9" value="HTTPS: baixa a aplicação&lt;br&gt;e chama /api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Implantacao-3" target="GASTRA_Arquitetura_Implantacao-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="195" y="185"/></Array></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-10" value="proxy reverso (D12)&lt;br&gt;REST/JSON + token JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Implantacao-5" target="GASTRA_Arquitetura_Implantacao-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-11" value="EF Core + Pomelo&lt;br&gt;leitura e escrita" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Implantacao-6" target="GASTRA_Arquitetura_Implantacao-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-12" value="HTTP/JSON na rede interna&lt;br&gt;pede o cálculo e recebe o resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Implantacao-6" target="GASTRA_Arquitetura_Implantacao-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-13" value="somente leitura das views&lt;br&gt;(usuário sem permissão de escrita)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GASTRA_Arquitetura_Implantacao-7" target="GASTRA_Arquitetura_Implantacao-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="605"/></Array></mxGeometry></mxCell><mxCell id="GASTRA_Arquitetura_Implantacao-14" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Borda contínua: já existe no repositório.&lt;br&gt;Os quatro contêineres sobem juntos com &lt;i&gt;docker compose --profile app up&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hoje, no desenvolvimento&lt;/b&gt;, só o MySQL roda no Docker; API, serviço analítico e Angular rodam direto na máquina (dotnet run, uvicorn, ng serve)." style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;fillColor=#fffbe6;strokeColor=#b3a100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="400" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>