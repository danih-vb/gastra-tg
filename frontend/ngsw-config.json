{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "casco",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/icone.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "icones",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icone-*.png", "/apple-touch-icon.png"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
