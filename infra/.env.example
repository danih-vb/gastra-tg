MYSQL_ROOT_PASSWORD=troque_esta_senha
MYSQL_DATABASE=gastra_dev
MYSQL_USER=gastra_app
MYSQL_PASSWORD=troque_esta_senha
MYSQL_PORT=3307
# Usuário somente leitura do serviço analítico (D10): criado por ./criar-usuario-analitico.sh
MYSQL_ANALITICA_PASSWORD=troque_esta_senha

# --- Só para o sistema inteiro em Docker (docker compose --profile app up -d --build) ---
# Chave que assina os tokens da API: pelo menos 32 caracteres aleatórios.
JWT_CHAVE_ASSINATURA=troque_por_uma_chave_aleatoria_de_32_ou_mais_caracteres
# Primeiro Gerente, criado quando o banco ainda não tem usuário. A senha precisa ter 8 caracteres ou mais.
ADMIN_EMAIL=gerente@gastra.local
ADMIN_SENHA=troque_esta_senha
# Development liga o Swagger em http://localhost:5019/swagger
API_AMBIENTE=Production

# --- Só para o semeador de dados simulados (backend/tools/GastraSemeador) ---
# Senha inicial de todas as contas fictícias que o semeador cria. 8 caracteres ou mais.
GASTRA_SEMEADOR_SENHA=troque_esta_senha
