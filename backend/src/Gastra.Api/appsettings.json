{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "gastra-api",
    "Audiencia": "gastra-web",
    "MinutosExpiracao": 480,
    "MinutosExpiracaoSegundoFator": 5
  },
  "Cors": {
    "OrigensPermitidas": [ "http://localhost:4200" ]
  },
  "Proxy": {
    "RedesConfiaveis": [ "172.16.0.0/12" ]
  },
  "LimiteRequisicoes": {
    "Habilitado": true,
    "AutenticacaoPorMinuto": 10,
    "ConsultaClientePorMinuto": 30
  },
  "Auditoria": {
    "EliminacaoAutomatica": true
  },
  "ServicoAnalitico": {
    "UrlBase": "http://localhost:8000",
    "TempoLimiteMilissegundos": 2000
  }
}
