@Gastra.Api_HostAddress = http://localhost:5019

# Cole aqui o tokenAcesso devolvido pelo login (ou pela confirmação do segundo fator)
@token = COLE_O_TOKEN_DE_ACESSO_AQUI
# Cole aqui o tokenSegundoFator devolvido pelo login de Gerente/Coordenador
@tokenSegundoFator = COLE_O_TOKEN_DO_SEGUNDO_FATOR_AQUI

GET {{Gastra.Api_HostAddress}}/health

###

# ===================== Autenticação =====================

# UC01 — Login (use o e-mail e a senha da seção Administrador do appsettings.Development.json)
POST {{Gastra.Api_HostAddress}}/api/autenticacao/login
Content-Type: application/json

{
  "email": "gerente@gastra.local",
  "senha": "SUA_SENHA"
}

###

# Primeiro acesso de Gerente/Coordenador: vincula o app autenticador (uma única vez)
POST {{Gastra.Api_HostAddress}}/api/autenticacao/segundo-fator/configurar
Content-Type: application/json

{
  "tokenSegundoFator": "{{tokenSegundoFator}}"
}

###

# UC02 — Código de 6 dígitos do app autenticador
POST {{Gastra.Api_HostAddress}}/api/autenticacao/segundo-fator/confirmar
Content-Type: application/json

{
  "tokenSegundoFator": "{{tokenSegundoFator}}",
  "codigo": "123456"
}

###

# UC03 — Encerrar sessão
POST {{Gastra.Api_HostAddress}}/api/autenticacao/logoff
Authorization: Bearer {{token}}

###

# ===================== Cardápio =====================

# UC05 — Cadastrar item (Gerente/Coordenador)
POST {{Gastra.Api_HostAddress}}/api/cardapio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Moqueca de banana-da-terra",
  "categoria": "PratoPrincipal",
  "preco": 72.50,
  "descricao": "Banana-da-terra, leite de coco e dendê",
  "flagsDieteticas": ["Vegano", "SemGluten", "SemLactose"]
}

###

# Cadastro inválido — mensagens em inglês
POST {{Gastra.Api_HostAddress}}/api/cardapio
Authorization: Bearer {{token}}
Content-Type: application/json
Accept-Language: en

{
  "nome": "",
  "categoria": "Bebida",
  "preco": 0,
  "descricao": "",
  "flagsDieteticas": []
}

###

# Gestão do cardápio: todos os itens (Gerente/Coordenador)
GET {{Gastra.Api_HostAddress}}/api/cardapio
Authorization: Bearer {{token}}

###

# UC19 — Cardápio digital: público, só itens disponíveis
GET {{Gastra.Api_HostAddress}}/api/cardapio/digital

###

GET {{Gastra.Api_HostAddress}}/api/cardapio/1

###

# UC06 — Atualizar preço
PATCH {{Gastra.Api_HostAddress}}/api/cardapio/1/preco
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "preco": 79.90
}

###

# UC07 — Marcar indisponível
PATCH {{Gastra.Api_HostAddress}}/api/cardapio/1/disponibilidade
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "disponivel": false
}

###

# ===================== Usuários (só Gerente) =====================

# UC04 — Cadastrar conta
POST {{Gastra.Api_HostAddress}}/api/usuarios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Carlos Lima",
  "email": "carlos@gastra.local",
  "senha": "SenhaForte123",
  "papel": "Garcom"
}

###

# UC04 — Listar contas (ativas e inativas)
GET {{Gastra.Api_HostAddress}}/api/usuarios
Authorization: Bearer {{token}}

###

GET {{Gastra.Api_HostAddress}}/api/usuarios/2
Authorization: Bearer {{token}}

###

# UC04 — Editar (trocar o papel derruba os tokens antigos dessa pessoa)
PUT {{Gastra.Api_HostAddress}}/api/usuarios/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Carlos Lima",
  "email": "carlos@gastra.local",
  "papel": "Metre"
}

###

# UC04 — Inativar (soft delete). Para reativar, envie "ativo": true
PATCH {{Gastra.Api_HostAddress}}/api/usuarios/2/situacao
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ativo": false
}

###

# ===================== Comandas (Garçom) =====================

# UC10 — Abrir comanda (informe uma mesa existente)
POST {{Gastra.Api_HostAddress}}/api/comandas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "mesaId": 1,
  "quantidadePessoas": 4
}

###

# UC11 — Confirmar ou ajustar a composição sugerida
PATCH {{Gastra.Api_HostAddress}}/api/comandas/1/composicao
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quantidadePessoas": 4,
  "composicao": "GrupoGrande"
}

###

# UC12 — Registrar item do pedido
POST {{Gastra.Api_HostAddress}}/api/comandas/1/itens
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "itemCardapioId": 1,
  "quantidade": 2
}

###

# UC23 — Marcar item entregue
PATCH {{Gastra.Api_HostAddress}}/api/comandas/1/itens/1/situacao
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "situacao": "Entregue"
}

###

# UC23 — Cancelar item (motivo obrigatório: ErroDeLancamento | ClienteDesistiu | ItemEmFalta)
PATCH {{Gastra.Api_HostAddress}}/api/comandas/1/itens/1/situacao
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "situacao": "Cancelado",
  "motivoCancelamento": "ItemEmFalta"
}

###

# UC13 — Registrar restrição alimentar
POST {{Gastra.Api_HostAddress}}/api/comandas/1/restricoes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoria": "SemGluten",
  "observacaoLivre": "sem molho de soja"
}

###

# RF04 — Remover a taxa de serviço a pedido do cliente
DELETE {{Gastra.Api_HostAddress}}/api/comandas/1/taxa-servico
Authorization: Bearer {{token}}

###

# UC14 — Fechar a comanda
POST {{Gastra.Api_HostAddress}}/api/comandas/1/fechamento
Authorization: Bearer {{token}}

###

# UC18 — Sugestões de itens para oferecer na mesa (suba o serviço Python para ver resultado)
GET {{Gastra.Api_HostAddress}}/api/comandas/1/sugestoes
Authorization: Bearer {{token}}

###

# Painel do salão: comandas abertas
GET {{Gastra.Api_HostAddress}}/api/comandas
Authorization: Bearer {{token}}

###

# UC20 — Consulta do cliente pelo QR code (sem login): use o codigoAcessoCliente da comanda
GET {{Gastra.Api_HostAddress}}/api/comandas/consulta/COLE_O_CODIGO_DE_ACESSO_AQUI

###

# ===================== Salão: praças e mesas (UC24) =====================

# UC24 — Cadastrar praça (Gerente)
POST {{Gastra.Api_HostAddress}}/api/pracas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "Varanda",
  "quantidadeGarcons": 2
}

###

# UC24 — Editar praça
PUT {{Gastra.Api_HostAddress}}/api/pracas/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "codigo": "Varanda",
  "quantidadeGarcons": 3
}

###

GET {{Gastra.Api_HostAddress}}/api/pracas
Authorization: Bearer {{token}}

###

# UC24 — Cadastrar mesa numa praça (Gerente)
POST {{Gastra.Api_HostAddress}}/api/mesas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numero": "12",
  "capacidade": 4,
  "pracaId": 1
}

###

# UC24 — Editar mesa (a praça não muda: vínculo fixo)
PUT {{Gastra.Api_HostAddress}}/api/mesas/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "numero": "12A",
  "capacidade": 6
}

###

# Lista que o garçom usa para abrir comanda
GET {{Gastra.Api_HostAddress}}/api/mesas
Authorization: Bearer {{token}}

###

# ===================== Alocação de garçons (UC15, UC21, UC22) — token de Metre =====================

# UC15 — Sugestão do turno para os garçons presentes (suba o serviço Python)
POST {{Gastra.Api_HostAddress}}/api/alocacoes/sugestao
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "data": "2026-09-17",
  "periodo": "Jantar",
  "garcomIds": [2, 3, 4]
}

###

# UC22 — Ajustar: garçom 3 vai para a praça 1
PUT {{Gastra.Api_HostAddress}}/api/alocacoes/2026-09-17/Jantar/garcons/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pracaId": 1
}

###

# UC21 — Confirmar o turno
POST {{Gastra.Api_HostAddress}}/api/alocacoes/2026-09-17/Jantar/confirmacao
Authorization: Bearer {{token}}

###

# Quem está em qual praça
GET {{Gastra.Api_HostAddress}}/api/alocacoes/2026-09-17/Jantar
Authorization: Bearer {{token}}

###
